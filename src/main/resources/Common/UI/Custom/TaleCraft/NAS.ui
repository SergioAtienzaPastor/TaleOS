$C = "../Common.ui";

Group #Nas {
  Anchor: (Width: 660, Height: 700);
  Background: #101824(0.98);
  LayoutMode: Top;
  Padding: (Full: 20);

  Label #Title {
    Text: "NAS TaleCraft";
    Anchor: (Height: 48);
    Style: (FontSize: 24, TextColor: #9ed8d0, RenderBold: true, VerticalAlignment: Center);
  }

  Label {
    Text: "BAHÍAS PENDRIVE";
    Anchor: (Height: 30);
    Style: (FontSize: 17, TextColor: #d9e2e8, RenderBold: true);
  }

  Group {
    Anchor: (Height: 166);
    LayoutMode: Middle;
    Background: #111a24(0.85);
    Padding: (Full: 10);

    ItemGrid #DriveGrid {
      SlotsPerRow: 4;
      AreItemsDraggable: true;
      Style: (
        SlotSize: 68,
        SlotIconSize: 58,
        SlotSpacing: 6,
        SlotBackground: "../Common/BlockSelectorSlotBackground.png"
      );
    }
  }

  Label #Status {
    Text: "0/8 PenDrives";
    Anchor: (Height: 36);
    Style: (FontSize: 14, TextColor: #9ed8d0, VerticalAlignment: Center);
  }

  Label #DragHint {
    Text: "Arrastra PenDrives entre las bahías y tu inventario";
    Anchor: (Height: 42);
    Style: (FontSize: 13, TextColor: #a7b7c9, VerticalAlignment: Center);
  }

  Label {
    Text: "TU INVENTARIO";
    Anchor: (Height: 38);
    Style: (FontSize: 17, TextColor: #d9e2e8, RenderBold: true);
  }

  Group {
    LayoutMode: Top;
    Background: #111a24(0.85);
    Padding: (Full: 9);

    ItemGrid #HotbarGrid {
      SlotsPerRow: 9;
      AreItemsDraggable: true;
      Style: (
        SlotSize: 54,
        SlotIconSize: 47,
        SlotSpacing: 5,
        SlotBackground: "../Common/BlockSelectorSlotBackground.png"
      );
    }

    Group { Anchor: (Height: 12); }

    ItemGrid #BackpackGrid {
      SlotsPerRow: 9;
      AreItemsDraggable: true;
      Style: (
        SlotSize: 54,
        SlotIconSize: 47,
        SlotSpacing: 5,
        SlotBackground: "../Common/BlockSelectorSlotBackground.png"
      );
    }
  }
}
