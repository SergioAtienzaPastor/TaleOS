$C = "../Common.ui";

Group #Terminal {
  Anchor: (Width: 1320, Height: 760);
  Background: #101824(0.98);
  LayoutMode: Left;
  Padding: (Full: 18);

  Group #TerminalColumn {
    Anchor: (Width: 724, Height: 724);
    LayoutMode: Top;
    Padding: (Right: 14);

    Group #TitleRow {
      Anchor: (Height: 44);
      LayoutMode: Left;

      Label #Title {
        Text: "Turtle";
        Style: (FontSize: 22, TextColor: #e4d39c, RenderBold: true, VerticalAlignment: Center);
      }

      Group { FlexWeight: 1; }

      $C.@SecondaryTextButton #Stop {
        Text: "Detener programa";
        Anchor: (Width: 180, Height: 36);
      }
    }

    Group { Anchor: (Height: 8); }

    Group #InputRow {
      Anchor: (Height: 46);
      LayoutMode: Left;
      Padding: (Left: 10, Right: 8);
      Background: #0b1118(0.8);

      Label #Prompt {
        Text: "tale> ";
        Style: (FontSize: 17, TextColor: #c8d8b8, VerticalAlignment: Center);
      }

      $C.@TextField #Input {
        FlexWeight: 1;
        AutoFocus: true;
        PlaceholderText: "Escribe un comando y pulsa Enter";
        Background: #0b1118(0.01);
        Style: (FontSize: 16);
      }

    }

    Label #CompletionHint {
      Text: "TAB autocompleta; repite para ciclar";
      Anchor: (Height: 22);
      Style: (FontSize: 12, TextColor: #a7b7c9, VerticalAlignment: Center);
    }

    Group { Anchor: (Height: 10); }

    Group #Screen {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Background: #111a24(0.92);
      Padding: (Full: 6);

      Label #Output {
        Text: "";
        Style: (FontSize: 16, TextColor: #d0dfc4);
      }
    }

    Label #Facing {
      Anchor: (Height: 30);
      Text: "Dirección";
      Style: (FontSize: 15, TextColor: #a7b7c9, VerticalAlignment: Center);
    }
  }

  Group #InventoryColumn {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Padding: (Left: 16);

    Label {
      Text: "TURTLE";
      Anchor: (Height: 38);
      Style: (FontSize: 19, TextColor: #e4d39c, RenderBold: true);
    }

    Group {
      Anchor: (Height: 292);
      LayoutMode: Middle;
      Background: #111a24(0.75);
      Padding: (Full: 10);

      ItemGrid #TurtleGrid {
        SlotsPerRow: 4;
        AreItemsDraggable: true;
        Style: (
          SlotSize: 64,
          SlotIconSize: 56,
          SlotSpacing: 8,
          SlotBackground: "../Common/BlockSelectorSlotBackground.png"
        );
      }
    }

    Label #ToolHint {
      Anchor: (Height: 34);
      Text: "Slot activo";
      Style: (FontSize: 14, TextColor: #a7b7c9, VerticalAlignment: Center);
    }

    Group {
      Anchor: (Height: 102);
      LayoutMode: Left;

      Group {
        Anchor: (Width: 232);
        LayoutMode: Top;
        Label {
          Text: "Mejora izquierda";
          Anchor: (Height: 30);
          Style: (FontSize: 15, TextColor: #b9c6d4);
        }
        ItemGrid #LeftToolGrid {
          SlotsPerRow: 1;
          AreItemsDraggable: true;
          Style: (
            SlotSize: 64,
            SlotIconSize: 56,
            SlotSpacing: 0,
            SlotBackground: "../Common/BlockSelectorSlotBackground.png"
          );
        }
      }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Label {
          Text: "Mejora derecha";
          Anchor: (Height: 30);
          Style: (FontSize: 15, TextColor: #b9c6d4);
        }
        ItemGrid #RightToolGrid {
          SlotsPerRow: 1;
          AreItemsDraggable: true;
          Style: (
            SlotSize: 64,
            SlotIconSize: 56,
            SlotSpacing: 0,
            SlotBackground: "../Common/BlockSelectorSlotBackground.png"
          );
        }
      }
    }

    Label #DragHint {
      Anchor: (Height: 38);
      Text: "Arrastra objetos entre las cuadrículas";
      Style: (FontSize: 14, TextColor: #a7b7c9, VerticalAlignment: Center);
    }

    Label {
      Text: "TU INVENTARIO";
      Anchor: (Height: 36);
      Style: (FontSize: 18, TextColor: #e4d39c, RenderBold: true);
    }

    Group {
      LayoutMode: Top;
      Background: #111a24(0.75);
      Padding: (Full: 8);

      ItemGrid #HotbarGrid {
        SlotsPerRow: 9;
        AreItemsDraggable: true;
        Style: (
          SlotSize: 52,
          SlotIconSize: 46,
          SlotSpacing: 4,
          SlotBackground: "../Common/BlockSelectorSlotBackground.png"
        );
      }

      Group { Anchor: (Height: 10); }

      ItemGrid #BackpackGrid {
        SlotsPerRow: 9;
        AreItemsDraggable: true;
        Style: (
          SlotSize: 52,
          SlotIconSize: 46,
          SlotSpacing: 4,
          SlotBackground: "../Common/BlockSelectorSlotBackground.png"
        );
      }
    }
  }
}
