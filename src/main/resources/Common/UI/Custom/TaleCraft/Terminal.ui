// TaleCraft terminal page. Layout path: TaleCraft/Terminal.ui
$C = "../Common.ui";

Group #Terminal {
  Anchor: (Width: 720, Height: 430);
  Background: #101418(0.97);
  LayoutMode: Top;
  Padding: (Full: 14);

  Group #TitleRow {
    Anchor: (Height: 30);
    LayoutMode: Left;

    Label #Title {
      Text: "Computer";
      FlexWeight: 1;
      Style: (FontSize: 16, TextColor: #d8c890, RenderBold: true, VerticalAlignment: Center);
    }

    Label #ScrollHint {
      Text: "";
      Anchor: (Right: 8);
      Style: (FontSize: 11, TextColor: #8a9a7a, VerticalAlignment: Center);
    }

    $C.@SecondaryTextButton #PageUp {
      Text: "Subir";
      Anchor: (Width: 64, Height: 28);
    }

    Group { Anchor: (Width: 6); }

    $C.@SecondaryTextButton #PageDown {
      Text: "Bajar";
      Anchor: (Width: 64, Height: 28);
    }
  }

  Group { Anchor: (Height: 6); }

  Group #Screen {
    FlexWeight: 1;
    LayoutMode: Top;

    // Elastic spacer: pushes the transcript to the bottom of the screen,
    // so the latest line sits just above the prompt like a real console.
    Group { FlexWeight: 1; }

    // Read-only multiline label (no internal scroll): TerminalPage feeds it a
    // window of the transcript capped to what fits the screen.
    Label #Output {
      Text: "";
      Style: (FontSize: 13, TextColor: #c8d8b8, Wrap: true);
    }
  }

  Group { Anchor: (Height: 8); }

  Group #InputRow {
    Anchor: (Height: 38);
    LayoutMode: Left;
    Padding: (Left: 10);

    Label #Prompt {
      Text: "tale> ";
      Style: (FontSize: 13, TextColor: #c8d8b8, VerticalAlignment: Center);
    }

    $C.@TextField #Input {
      FlexWeight: 1;
      PlaceholderText: "escribe un comando y pulsa Enter";
      Background: #101418;
    }
  }
}
