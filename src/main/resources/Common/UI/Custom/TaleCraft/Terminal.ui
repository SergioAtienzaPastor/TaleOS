// TaleCraft terminal page. Layout path: TaleCraft/Terminal.ui
$C = "../Common.ui";

Group #Terminal {
  Anchor: (Width: 720, Height: 430);
  Background: #101418(0.97);
  LayoutMode: Top;
  Padding: (Full: 14);

  Label #Title {
    Text: "Computer";
    Anchor: (Height: 30);
    Style: (FontSize: 16, TextColor: #d8c890, RenderBold: true);
  }

  Group { Anchor: (Height: 6); }

  Group #Screen {
    FlexWeight: 1;
    LayoutMode: Top;

    $C.@MultilineTextField #Output {
      FlexWeight: 1;
      PlaceholderText: "";
      IsReadOnly: true;
      Style: (TextColor: #c8d8b8);
    }
  }

  Group { Anchor: (Height: 8); }

  Group #InputRow {
    Anchor: (Height: 38);
    LayoutMode: Left;
    Padding: (Left: 10);

    Label #Prompt {
      Text: "tale> ";
      Style: (FontSize: 13, TextColor: #c8d8b8, VerticalAlignment: Center);
    }

    $C.@TextField #Input {
      FlexWeight: 1;
      PlaceholderText: "escribe un comando y pulsa Enter";
      Background: #101418;
    }
  }
}
